{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "dev": "ng serve --host 0.0.0.0 --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:watch": "ng test --watch --browsers ChromeHeadless",
    "test:ci": "ng test --no-watch --browsers ChromeHeadless",
    "test:coverage": "ng test --coverage --browsers ChromeHeadless",
    "lint": "eslint . --max-warnings=378",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "e2e": "npx playwright test",
    "e2e:ui": "npx playwright test --ui",
    "cap:sync": "npx cap sync",
    "cap:copy": "npx cap copy",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:build:android": "npx cap build android",
    "cap:build:ios": "npx cap build ios",
    "cap:run:android": "npx cap run android",
    "cap:run:ios": "npx cap run ios",
    "mobile:build": "npm run build && npx cap copy",
    "mobile:build:android": "npm run build && npx cap sync android",
    "mobile:build:ios": "npm run build && npx cap sync ios"
  },
  "private": true,
  "packageManager": "npm@9.9.4",
  "dependencies": {
    "@angular/animations": "^21.2.25",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@angular/service-worker": "^21.2.25",
    "@capacitor/app": "^8.1.0",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/device": "^8.0.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capgo/capacitor-native-biometric": "^8.4.8",
    "@primeng/themes": "^21.0.4",
    "chart.js": "^4.5.1",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.6",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.3",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/build": "^21.2.27",
    "@angular/cli": "^21.2.27",
    "@angular/compiler-cli": "^21.2.25",
    "@angular/platform-browser-dynamic": "^21.2.25",
    "@capacitor/android": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^9.25.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "piscina": "5.3.2",
    "tar": "7.5.22",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@xmldom/xmldom": "0.9.12",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@5": "5.0.12",
    "browserslist": "4.29.4",
    "fast-uri": "3.1.9",
    "hono": "4.13.13",
    "http-cache-semantics": "4.3.0",
    "immutable": "5.1.9",
    "ip-address": "10.7.4",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.20",
    "pacote": "21.5.1",
    "postcss": "8.5.31",
    "sigstore": "4.1.1",
    "socket.io-parser": "4.2.7",
    "source-map-js": "1.2.2",
    "undici@6": "6.29.1",
    "undici@7": "7.30.1",
    "vite": "7.3.7",
    "ws": "8.22.0"
  }
}

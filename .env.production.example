# ─── VardiyaOS Production Configuration ───────────────────────────────
# Copy to .env and fill in secrets

# Database (through PgBouncer for connection pooling)
DATABASE_URL="postgresql://vardiya:CHANGE_ME@pgbouncer:6432/vardiyasystem?schema=public&connection_limit=25&pgbouncer=true"
# Direct connection for Prisma migrations (bypasses PgBouncer)
DATABASE_DIRECT_URL="postgresql://vardiya:CHANGE_ME@postgres:5432/vardiyasystem?schema=public&connection_limit=5"

# JWT Secrets (generate with: openssl rand -hex 64)
JWT_ACCESS_TOKEN_SECRET="CHANGE_ME_GENERATE_64_HEX_CHARS"
JWT_REFRESH_TOKEN_SECRET="CHANGE_ME_GENERATE_64_HEX_CHARS"
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=production

# URLs
FRONTEND_URL="https://vardiya.example.com"
WS_CORS_ORIGIN="https://vardiya.example.com"

# Seed Passwords (change immediately after first deploy)
SEED_ADMIN_PASSWORD="CHANGE_ME_ADMIN"
SEED_TECHNICIAN_PASSWORD="CHANGE_ME_TECH"

# Rate Limiting
GLOBAL_THROTTLE_TTL=60000
GLOBAL_THROTTLE_LIMIT=200
AUTH_LOGIN_LIMIT=10
AUTH_REGISTER_LIMIT=3
AUTH_REFRESH_LIMIT=10

# Account Lockout
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_DURATION=900000
AUTH_LOCKOUT_PROGRESSIVE_FACTOR=2
AUTH_LOCKOUT_MAX_DURATION=86400000

# WebSocket
WS_CONNECTION_LIMIT=10
WS_CONNECTION_WINDOW_MS=60000
WS_RECONNECT_COOLDOWN_MS=2000

# Trust Proxy (set to 1 if behind nginx reverse proxy)
TRUST_PROXY_LEVEL=1

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# Alerting
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/xxx/yyy/zzz"

# Vault Integration (optional — falls back to env vars if not configured)
# VAULT_ADDR="http://vault:8200"
# VAULT_ROLE_ID="your-approle-role-id"
# VAULT_SECRET_ID="your-approle-secret-id"
# VAULT_SECRET_PATH="secret/vardiya"

# Docker Secrets (optional — used when secrets are mounted at /run/secrets/)
# DB_PASSWORD_FILE="/run/secrets/db_password"
# JWT_ACCESS_TOKEN_SECRET_FILE="/run/secrets/jwt_access_secret"
# JWT_REFRESH_TOKEN_SECRET_FILE="/run/secrets/jwt_refresh_secret"
# SLACK_WEBHOOK_FILE="/run/secrets/slack_webhook"

# Redis for distributed rate limiting and session/cache
REDIS_URL="redis://redis:6379"

# Optional: SMTP for email notifications
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="noreply@example.com"
# SMTP_PASS="CHANGE_ME"
# SMTP_FROM="VardiyaOS <noreply@example.com>"

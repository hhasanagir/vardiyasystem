{
  "title": "VardiyaOS — Production Monitoring",
  "uid": "vardiyaos-prod",
  "version": 1,
  "timezone": "Europe/Istanbul",
  "editable": true,
  "tags": ["vardiyaos", "production"],
  "refresh": "30s",
  "panels": [
    {
      "title": "API Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(vardiya_http_requests_total[5m])",
          "legendFormat": "{{method}} {{path}}",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rps",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "title": "API Latency (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(vardiya_http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(vardiya_http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(vardiya_http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "title": "HTTP Error Rate (4xx/5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(vardiya_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(vardiya_http_requests_total[5m])) * 100",
          "legendFormat": "5xx %"
        },
        {
          "expr": "sum(rate(vardiya_http_requests_total{status=~\"4..\"}[5m])) / sum(rate(vardiya_http_requests_total[5m])) * 100",
          "legendFormat": "4xx %"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent" }
      }
    },
    {
      "title": "In-Flight Requests",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "vardiya_http_in_flight_requests",
          "legendFormat": "in-flight"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "title": "Auth Login Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "rate(vardiya_auth_login_total[5m])",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "title": "Auth Login Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(vardiya_auth_login_duration_seconds_bucket[5m]))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "title": "Shifts Created",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "rate(vardiya_shift_created_total[24h])",
          "legendFormat": "shifts/day"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "title": "Swap Requests",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 16 },
      "targets": [
        {
          "expr": "rate(vardiya_swap_request_total[24h])",
          "legendFormat": "swaps/day"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "title": "Notifications Delivered",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
      "targets": [
        {
          "expr": "rate(vardiya_notification_delivered_total[5m])",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "title": "Notification Failures",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 16 },
      "targets": [
        {
          "expr": "rate(vardiya_notification_failed_total[5m])",
          "legendFormat": "{{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed" },
          "custom": { "fillOpacity": 80 }
        }
      }
    },
    {
      "title": "DB Query Duration (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(vardiya_db_query_duration_seconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(vardiya_db_query_duration_seconds_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(vardiya_db_query_duration_seconds_bucket[5m]))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "title": "DB Query Rate by Model",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "targets": [
        {
          "expr": "topk(10, rate(vardiya_db_queries_total[5m]))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "title": "Slow DB Queries",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "targets": [
        {
          "expr": "rate(vardiya_db_slow_queries_total[5m])",
          "legendFormat": "{{model}} {{action}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed" },
          "custom": { "fillOpacity": 80 }
        }
      }
    },
    {
      "title": "WebSocket Connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 12, "y": 30 },
      "targets": [
        {
          "expr": "vardiya_ws_connections",
          "legendFormat": "active"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "title": "WebSocket Events",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 38 },
      "targets": [
        {
          "expr": "rate(vardiya_ws_events_total[5m])",
          "legendFormat": "{{event}}"
        }
      ]
    },
    {
      "title": "WebSocket Errors",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 38 },
      "targets": [
        {
          "expr": "rate(vardiya_ws_errors_total[5m])",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "title": "Device Incidents by Severity",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 38 },
      "targets": [
        {
          "expr": "rate(vardiya_incident_created_total[5m])",
          "legendFormat": "{{severity}}"
        }
      ]
    },
    {
      "title": "Node.js Heap Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 46 },
      "targets": [
        {
          "expr": "nodejs_heap_size_used_bytes / nodejs_heap_size_total_bytes * 100",
          "legendFormat": "heap %"
        },
        { "expr": "nodejs_external_memory_bytes", "legendFormat": "external" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent" }
      }
    },
    {
      "title": "Event Processing Latency (Health Check)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 46 },
      "targets": [
        {
          "expr": "rate(vardiya_http_request_duration_seconds_sum{path=~\"health.*\"}[5m]) / rate(vardiya_http_request_duration_seconds_count{path=~\"health.*\"}[5m])",
          "legendFormat": "avg latency"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    }
  ],
  "rows": [],
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["vardiyaos"],
  "templating": {
    "list": [
      {
        "name": "env",
        "type": "constant",
        "label": "Environment",
        "query": "production",
        "current": { "value": "production" }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Deployments",
        "type": "grafana_annotation",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "enable": true,
        "iconColor": "blue",
        "query": "vardiya_deployment_info"
      }
    ]
  },
  "links": [
    {
      "title": "API Docs",
      "url": "https://vardiya.example.com/api/docs",
      "targetBlank": true
    },
    {
      "title": "Runbook",
      "url": "https://github.com/anomalyco/vardiyasystem/docs/devops",
      "targetBlank": true
    }
  ]
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@prisma/client": ["../backend/node_modules/@prisma/client"],
      "bcrypt": ["../backend/node_modules/@types/bcrypt"]
    }
  },
  "include": ["**/*.ts"]
}

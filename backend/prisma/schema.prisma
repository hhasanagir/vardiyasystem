generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DATABASE_DIRECT_URL")
  extensions = [btree_gin, citext, ltree, pg_stat_statements, pgcrypto]
}

model Role {
  id          String                @id @default(uuid())
  name        RbacRoleName          @unique
  label       String
  description String?
  level       Int
  isSystem    Boolean               @default(false)
  parentId    String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  path        Unsupported("ltree")?
  permissions RolePermission[]
  parent      Role?                 @relation("RoleHierarchy", fields: [parentId], references: [id])
  children    Role[]                @relation("RoleHierarchy")
  userRoles   UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  label       String
  description String?
  module      String
  action      String
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id              String         @id @default(uuid())
  userId          String
  roleId          String
  organizationId  String?
  unitId          String?
  assignedBy      String?
  expiresAt       DateTime?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  hospitalGroupId String?
  hospitalId      String?
  departmentId    String?
  department      Department?    @relation(fields: [departmentId], references: [id])
  hospitalGroup   HospitalGroup? @relation(fields: [hospitalGroupId], references: [id])
  hospital        Hospital?      @relation(fields: [hospitalId], references: [id])
  role            Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, organizationId, unitId])
  @@index([userId, isActive])
  @@index([roleId])
  @@index([hospitalGroupId])
  @@index([hospitalId])
  @@index([departmentId])
  @@map("user_role_assignments")
}

model User {
  id                      String                  @id @default(uuid())
  email                   String                  @unique
  password                String
  name                    String
  role                    UserRole                @default(guest)
  organizationId          String?
  unitId                  String?
  isActive                Boolean                 @default(true)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  attendanceRecords       AttendanceRecord[]
  auditLogs               AuditLog[]
  authSessions            AuthSession[]
  resolvedConflicts       Conflict[]              @relation("ConflictResolver")
  consentRecords          ConsentRecord[]
  dataSubjectRequests     DataSubjectRequest[]
  deviceIncidents         DeviceIncident[]
  deviceOffDates          DeviceOffDate[]
  deviceStatusLogs        DeviceStatusLog[]
  emergencyAccessGranted  EmergencyAccessGrant[]  @relation("EmergencyAccessGranter")
  emergencyAccessGrants   EmergencyAccessGrant[]  @relation("EmergencyAccessUser")
  handoverNotes           HandoverNote[]
  inviteCodes             InviteCode[]
  notificationPreferences NotificationPreference?
  notificationRecipients  NotificationRecipient[]
  sentNotifications       Notification[]          @relation("NotificationSender")
  preShiftChecklists      PreShiftChecklist[]
  pushTokens              PushToken[]
  recommendations         Recommendation[]
  snapshots               ScheduleSnapshot[]
  schedules               Schedule[]              @relation("ScheduleCreator")
  shiftTasks              ShiftTask[]
  roleAssignments         UserRoleAssignment[]
  organization            Organization?           @relation(fields: [organizationId], references: [id])
  unit                    Unit?                   @relation(fields: [unitId], references: [id])
  webPushSubscriptions    WebPushSubscription[]

  @@map("users")
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String   @default("android")
  deviceId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([userId, isActive])
  @@map("push_tokens")
}

model WebPushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  auth      String
  p256dh    String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("web_push_subscriptions")
}

model Organization {
  id                   String                @id @default(uuid())
  name                 String
  code                 String                @unique
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  hospitalId           String?
  assignments          Assignment[]
  devices              Device[]
  dutyRoster           DutyRoster[]
  enterpriseAssets     EnterpriseAsset[]
  inviteCodes          InviteCode[]
  hospital             Hospital?             @relation(fields: [hospitalId], references: [id])
  personShiftTemplates PersonShiftTemplate[]
  personnel            Personnel[]
  personnelGroups      PersonnelGroup[]
  schedules            Schedule[]
  shifts               Shifts[]
  swap_requests        SwapRequest[]
  units                Unit[]
  users                User[]

  @@map("organizations")
}

model HospitalGroup {
  id              String                @id @default(uuid())
  name            String
  code            String                @unique
  path            Unsupported("ltree")?
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  hospitals       Hospital[]
  roleAssignments UserRoleAssignment[]

  @@index([code])
  @@map("hospital_groups")
}

model Hospital {
  id               String                @id @default(uuid())
  groupId          String?
  name             String
  code             String                @unique
  path             Unsupported("ltree")?
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  departments      Department[]
  directorates     Directorate[]
  enterpriseAssets EnterpriseAsset[]
  group            HospitalGroup?        @relation(fields: [groupId], references: [id])
  organizations    Organization[]
  units            Unit[]
  roleAssignments  UserRoleAssignment[]
  warehouses       Warehouse[]

  @@index([code])
  @@map("hospitals")
}

model Directorate {
  id          String                @id @default(uuid())
  hospitalId  String
  name        String
  code        String
  path        Unsupported("ltree")?
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  departments Department[]
  hospital    Hospital              @relation(fields: [hospitalId], references: [id])

  @@unique([hospitalId, code])
  @@map("directorates")
}

model Department {
  id                    String                @id @default(uuid())
  hospitalId            String?
  directorateId         String?
  name                  String
  code                  String
  path                  Unsupported("ltree")?
  isActive              Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  directorate           Directorate?          @relation(fields: [directorateId], references: [id])
  hospital              Hospital?             @relation(fields: [hospitalId], references: [id])
  enterpriseAssets      EnterpriseAsset[]     @relation("AssetDepartment")
  ownedEnterpriseAssets EnterpriseAsset[]     @relation("AssetOwnerDepartment")
  units                 Unit[]
  roleAssignments       UserRoleAssignment[]

  @@unique([hospitalId, code])
  @@map("departments")
}

model Unit {
  id                   String                @id @default(uuid())
  name                 String
  code                 String
  type                 UnitType
  organizationId       String?
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  path                 Unsupported("ltree")?
  departmentId         String?
  hospitalId           String?
  areas                Area[]
  assignments          Assignment[]
  deviceIncidents      DeviceIncident[]
  devices              Device[]
  dutyRoster           DutyRoster[]
  enterpriseAssets     EnterpriseAsset[]
  handoverNotes        HandoverNote[]
  personShiftTemplates PersonShiftTemplate[]
  personnel            Personnel[]
  personnelGroups      PersonnelGroup[]
  schedules            Schedule[]
  shifts               Shifts[]
  department           Department?           @relation(fields: [departmentId], references: [id])
  hospital             Hospital?             @relation(fields: [hospitalId], references: [id])
  organization         Organization?         @relation(fields: [organizationId], references: [id])
  users                User[]

  @@unique([organizationId, code])
  @@map("units")
}

model Area {
  id        String                @id @default(uuid())
  unitId    String
  name      String
  code      String
  type      AreaType              @default(scanning)
  path      Unsupported("ltree")?
  isActive  Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  unit      Unit                  @relation(fields: [unitId], references: [id])
  rooms     Room[]

  @@unique([unitId, code])
  @@map("areas")
}

model Room {
  id               String                @id @default(uuid())
  areaId           String
  name             String
  code             String
  type             RoomType              @default(patient_exam)
  path             Unsupported("ltree")?
  capacity         Int                   @default(1)
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  assignmentSlots  AssignmentSlot[]
  devices          Device[]
  enterpriseAssets EnterpriseAsset[]
  area             Area                  @relation(fields: [areaId], references: [id])

  @@unique([areaId, code])
  @@map("rooms")
}

model AssignmentSlot {
  id         String               @id @default(uuid())
  roomId     String?
  deviceId   String?
  date       String
  startTime  String
  endTime    String
  shiftType  ShiftType
  status     AssignmentSlotStatus @default(available)
  assignedTo String?
  scheduleId String?
  isActive   Boolean              @default(true)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  device     Device?              @relation(fields: [deviceId], references: [id])
  room       Room?                @relation(fields: [roomId], references: [id])

  @@unique([roomId, deviceId, date, startTime])
  @@index([date])
  @@index([roomId, date])
  @@index([deviceId, date])
  @@index([status])
  @@index([assignedTo])
  @@map("assignment_slots")
}

model DutyRoster {
  id             String         @id @default(uuid())
  organizationId String
  unitId         String?
  deviceId       String?
  personnelId    String
  date           String
  shiftType      ShiftType
  role           DutyRosterRole
  startTime      String
  endTime        String
  notes          String?
  isActive       Boolean        @default(true)
  version        Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  device         Device?        @relation(fields: [deviceId], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id])
  personnel      Personnel      @relation(fields: [personnelId], references: [id])
  unit           Unit?          @relation(fields: [unitId], references: [id])

  @@unique([personnelId, date, shiftType])
  @@index([organizationId, date])
  @@index([unitId, date])
  @@index([deviceId, date])
  @@index([date, shiftType])
  @@map("duty_roster")
}

model Personnel {
  id                          String                        @id @default(uuid())
  name                        String
  role                        String                        @default("technician")
  employeeNo                  String?                       @unique
  email                       String?                       @unique
  phone                       String?
  unitId                      String
  skills                      String[]
  seniority                   Int                           @default(0)
  specialization              String?
  experienceYears             Int                           @default(0)
  certifications              String[]
  deviceSkills                String[]
  nightShiftEligible          Boolean                       @default(true)
  employmentStatus            String                        @default("active")
  startDate                   DateTime?
  notes                       String?
  offDays                     Int[]                         @default([])
  maxWeeklyHours              Int                           @default(40)
  isActive                    Boolean                       @default(true)
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  version                     Int                           @default(1)
  groupId                     String?
  organizationId              String?
  assignments                 Assignment[]
  calibrationsPerformed       CalibrationRecord[]           @relation("CalibrationPerformer")
  dutyRoster                  DutyRoster[]
  group                       PersonnelGroup?               @relation(fields: [groupId], references: [id])
  organizations               Organization?                 @relation(fields: [organizationId], references: [id])
  unit                        Unit                          @relation(fields: [unitId], references: [id])
  personnelDateAvailabilities PersonnelDateAvailability[]
  personnelSkills             PersonnelSkill[]
  personnelTrainings          PersonnelTraining[]
  dosimeters                  RadiationDosimeter[]
  swapRequestsAsRequester     SwapRequest[]                 @relation("SwapRequester")
  swapRequestsAsTarget        SwapRequest[]                 @relation("SwapTarget")

  @@index([unitId])
  @@index([unitId, isActive])
  @@index([groupId])
  @@index([organizationId])
  @@map("personnel")
}

model Skill {
  id              String           @id @default(uuid())
  name            String           @unique
  category        String           @default("imaging")
  description     String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  personnelSkills PersonnelSkill[]

  @@index([category])
  @@map("skills")
}

model PersonnelSkill {
  id                 String    @id @default(uuid())
  personnelId        String
  skillId            String
  certificationLevel String    @default("certified")
  certifiedAt        DateTime?
  expiresAt          DateTime?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  personnel          Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  skill              Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([personnelId, skillId])
  @@index([personnelId])
  @@index([skillId])
  @@index([expiresAt])
  @@map("personnel_skills")
}

model Device {
  id               String                @id @default(uuid())
  code             String
  name             String
  unitId           String
  organizationId   String?
  mode             DeviceMode            @default(vardiya)
  requiredSkills   String[]
  workDays         Int[]
  startHour        Int                   @default(8)
  endHour          Int                   @default(20)
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  roomId           String?
  path             Unsupported("ltree")?
  blockCode        String?
  isMaster         Boolean               @default(false)
  assignmentSlots  AssignmentSlot[]
  assignments      Assignment[]
  deviceIncidents  DeviceIncident[]
  deviceOffDates   DeviceOffDate[]
  deviceStatusLogs DeviceStatusLog[]
  organization     Organization?         @relation(fields: [organizationId], references: [id])
  room             Room?                 @relation(fields: [roomId], references: [id])
  unit             Unit                  @relation(fields: [unitId], references: [id])
  dutyRoster       DutyRoster[]
  enterpriseAsset  EnterpriseAsset?
  handoverNotes    HandoverNote[]
  shiftDefinitions Shifts[]

  @@unique([organizationId, code])
  @@index([unitId])
  @@index([roomId])
  @@index([organizationId])
  @@map("devices")
}

model Shifts {
  id                 String              @id @default(uuid())
  name               String
  type               ShiftType
  startTime          String?
  endTime            String?
  durationHours      Float?
  organizationId     String
  unitId             String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deviceId           String?
  personnelType      String?             @default("technician")
  isMaster           Boolean             @default(false)
  blockId            String?
  optionalOnWeekends Boolean             @default(false)
  optionalOnHolidays Boolean             @default(false)
  dateOverrides      ShiftDateOverride[]
  device             Device?             @relation(fields: [deviceId], references: [id])
  organization       Organization        @relation(fields: [organizationId], references: [id])
  unit               Unit?               @relation(fields: [unitId], references: [id])

  @@index([unitId])
  @@index([organizationId])
  @@index([deviceId])
  @@index([blockId])
  @@map("shifts")
}

model ShiftDateOverride {
  id          String   @id @default(uuid())
  shiftId     String
  date        String
  isEnabled   Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shift       Shifts   @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([shiftId, date])
  @@index([date])
  @@map("shift_date_overrides")
}

model PersonnelGroup {
  id             String                @id @default(uuid())
  organizationId String?
  unitId         String?
  name           String
  code           String
  description    String?
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  assignments    Assignment[]
  shiftTemplates PersonShiftTemplate[]
  personnel      Personnel[]
  organization   Organization?         @relation(fields: [organizationId], references: [id])
  unit           Unit?                 @relation(fields: [unitId], references: [id])

  @@unique([unitId, code])
  @@index([unitId])
  @@index([isActive])
  @@map("personnel_groups")
}

model PersonShiftTemplate {
  id               String         @id @default(uuid())
  organizationId   String?
  unitId           String
  personnelGroupId String
  name             String
  shiftType        ShiftType
  startTime        String
  endTime          String
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  assignments      Assignment[]
  organization     Organization?  @relation(fields: [organizationId], references: [id])
  personnelGroup   PersonnelGroup @relation(fields: [personnelGroupId], references: [id], onDelete: Cascade)
  unit             Unit           @relation(fields: [unitId], references: [id])

  @@index([unitId])
  @@index([personnelGroupId])
  @@index([isActive])
  @@map("person_shift_templates")
}

model Schedule {
  id             String             @id @default(uuid())
  unitId         String
  month          Int
  year           Int
  version        Int                @default(1)
  status         ScheduleStatus     @default(draft)
  publishedAt    DateTime?
  createdById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organizationId String?
  assignments    Assignment[]
  approval       ScheduleApproval?
  snapshots      ScheduleSnapshot[]
  createdBy      User?              @relation("ScheduleCreator", fields: [createdById], references: [id])
  organization   Organization?      @relation(fields: [organizationId], references: [id])
  unit           Unit               @relation(fields: [unitId], references: [id])

  @@unique([unitId, month, year])
  @@index([status])
  @@index([createdById])
  @@index([unitId, createdAt])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("schedules")
}

model ScheduleApproval {
  id               String    @id @default(uuid())
  scheduleId       String    @unique
  submittedBy      String?
  submittedAt      DateTime?
  submittedComment String?
  approvedBy       String?
  approvedAt       DateTime?
  approvalComment  String?
  rejectedBy       String?
  rejectedAt       DateTime?
  rejectionReason  String?
  publishedBy      String?
  publishedAt      DateTime?
  archivedBy       String?
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  schedule         Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@map("schedule_approvals")
}

model ScheduleSnapshot {
  id          String   @id @default(uuid())
  scheduleId  String
  version     Int
  data        Json
  createdById String?
  createdAt   DateTime @default(now())
  createdBy   User?    @relation(fields: [createdById], references: [id])
  schedule    Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, version])
  @@map("schedule_snapshots")
}

model Assignment {
  id                 String               @id @default(uuid())
  scheduleId         String
  personnelId        String
  deviceId           String?
  date               String
  shiftType          ShiftType
  startTime          String
  endTime            String
  isConfirmed        Boolean              @default(false)
  version            Int                  @default(1)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  personnelType      String               @default("technician")
  kind               AssignmentKind       @default(device)
  personnelGroupId   String?
  shiftTemplateId    String?
  unitId             String?
  source             AssignmentSource     @default(manual)
  overrideReason     String?
  overriddenBy       String?
  overriddenAt       DateTime?
  organizationId     String?
  device             Device?              @relation(fields: [deviceId], references: [id])
  organizations      Organization?        @relation(fields: [organizationId], references: [id])
  personnelGroup     PersonnelGroup?      @relation(fields: [personnelGroupId], references: [id])
  personnel          Personnel            @relation(fields: [personnelId], references: [id])
  schedule           Schedule             @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  shiftTemplate      PersonShiftTemplate? @relation(fields: [shiftTemplateId], references: [id])
  unit               Unit?                @relation(fields: [unitId], references: [id])
  attendanceRecords  AttendanceRecord[]
  preShiftChecklists PreShiftChecklist[]
  shiftTasks         ShiftTask[]
  swapRequestsFrom   SwapRequest[]        @relation("SwapFromAssignment")
  swapRequestsTo     SwapRequest[]        @relation("SwapToAssignment")

  @@unique([scheduleId, deviceId, date, shiftType, personnelType])
  @@unique([personnelId, date, shiftType])
  @@index([personnelId, date])
  @@index([deviceId])
  @@index([date])
  @@index([scheduleId])
  @@index([scheduleId, personnelId])
  @@index([scheduleId, date])
  @@index([unitId])
  @@index([personnelGroupId])
  @@index([kind])
  @@index([organizationId])
  @@index([source])
  @@map("assignments")
}

model Holiday {
  id        String   @id @default(uuid())
  date      String   @unique
  name      String
  type      String
  year      Int
  createdAt DateTime @default(now())

  @@map("holidays")
}

model AuditLog {
  id                 String                  @id @default(uuid())
  userId             String
  actionType         String
  entityType         String
  entityId           String?
  oldValue           Json?
  newValue           Json?
  ipAddress          String?
  userAgent          String?
  metadata           Json?
  flagged            Boolean                 @default(false)
  flagReason         String?
  flaggedAt          DateTime?
  flaggedBy          String?
  createdAt          DateTime                @default(now())
  requestId          String?
  userName           String?
  userRole           String?
  organizationId     String?
  hospitalId         String?
  unitId             String?
  description        String?
  status             String                  @default("SUCCESS")
  dataClassification AuditDataClassification @default(UNCLASSIFIED)
  retentionHash      String?
  consentId          String?
  user               User                    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([actionType])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([hospitalId])
  @@index([unitId])
  @@index([status])
  @@index([flagged])
  @@index([dataClassification])
  @@index([retentionHash])
  @@map("audit_logs")
}

model SwapRequest {
  id                String        @id @default(uuid())
  requesterId       String
  targetPersonnelId String
  fromAssignmentId  String
  toAssignmentId    String?
  reason            String?
  status            String        @default("PENDING")
  approvedById      String?
  approvedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  organizationId    String?
  fromAssignment    Assignment    @relation("SwapFromAssignment", fields: [fromAssignmentId], references: [id], onDelete: Cascade)
  organizations     Organization? @relation(fields: [organizationId], references: [id])
  requester         Personnel     @relation("SwapRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  targetPersonnel   Personnel     @relation("SwapTarget", fields: [targetPersonnelId], references: [id], onDelete: Cascade)
  toAssignment      Assignment?   @relation("SwapToAssignment", fields: [toAssignmentId], references: [id])

  @@index([requesterId])
  @@index([targetPersonnelId])
  @@index([status])
  @@index([organizationId])
  @@map("swap_requests")
}

model Recommendation {
  id                  String                 @id @default(uuid())
  organizationId      String
  createdById         String?
  type                RecommendationType
  priority            RecommendationPriority
  score               Float
  title               String
  description         String
  impactFatigue       Float?
  impactFairness      Float?
  impactCoverage      Float?
  impactOverall       Float?
  shiftIds            String[]
  userIds             String[]
  suggestedActionType String?
  suggestedActionData Json?

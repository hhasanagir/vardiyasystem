generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DATABASE_DIRECT_URL")
  extensions = [pgcrypto, citext, btree_gin, pg_stat_statements, ltree]
}

enum UnitType {
  mr
  bt
  rontgen
  nukleer
  onkoloji
  ultrason
  anjiyo
  mamografi
  kemik_dansitometri
  floroskopi
  pet_ct
  spect_ct
  linak
  simutasyon_ct
  mobil
  supervizor
}

enum AreaType {
  scanning
  control
  preparation
  storage
  waiting
  recovery
  office
  utility
}

enum RoomType {
  patient_exam
  equipment
  control
  preparation
  storage
  consultation
  recovery
  utility
}

enum AssignmentSlotStatus {
  available
  occupied
  reserved
  maintenance
  closed
}

enum ShiftType {
  day
  evening
  night
  morning
  off
  leave
  sick
  training
  backup
}

enum AssignmentKind {
  device
  person
}

enum AssignmentSource {
  manual
  auto_generated
  override
  swap
  template
  import
}

enum DutyRosterRole {
  sorumlu_tekniker
  tekniker
  yardimci_tekniker
  supervisor
  radyolog
}

enum DeviceMode {
  vardiya
  polyclinic
}

enum TaskStatus {
  pending
  completed
  skipped
}

enum DeviceOperationalStatus {
  active
  maintenance
  fault
  out_of_service
}

enum ScheduleStatus {
  draft
  under_review
  approved
  published
  archived
  rejected
}

enum UserRole {
  system_admin
  hospital_admin
  imaging_director
  supervisor
  medical_engineer
  senior_technician
  technician
  assistant_technician
  secretary
  guest
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationType {
  SCHEDULE_CHANGED
  SCHEDULE_APPROVED
  SCHEDULE_REJECTED
  SHIFT_SWAP_REQUESTED
  SHIFT_SWAP_APPROVED
  SHIFT_SWAP_REJECTED
  TRAINING_ASSIGNED
  TRAINING_EXPIRING
  TRAINING_EXPIRED
  CERTIFICATION_EXPIRING
  CERTIFICATION_EXPIRED
  DEVICE_INCIDENT
  DEVICE_INCIDENT_CRITICAL
  SYSTEM_ANNOUNCEMENT
  ROLE_ASSIGNED
  PERMISSION_CHANGED
  ATTENDANCE_ALERT
  EMERGENCY_ALERT
  CLOCK_IN_REMINDER
  SCHEDULE_REMINDER
}

enum NotificationStatus {
  PENDING
  SENT
  PARTIALLY_DELIVERED
  DELIVERED
  READ
  FAILED
}

enum DeliveryChannel {
  IN_APP
  WEB_PUSH
  FCM
  EMAIL
  SMS
}

enum DeliveryStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  READ
  CLICKED
  FAILED
}

enum RbacRoleName {
  SYSTEM_ADMIN
  HOSPITAL_ADMIN
  IMAGING_DIRECTOR
  SUPERVISOR
  MEDICAL_ENGINEER
  SENIOR_TECHNICIAN
  TECHNICIAN
  ASSISTANT_TECHNICIAN
  SECRETARY
  GUEST
}

model Role {
  id          String                @id @default(uuid())
  name        RbacRoleName          @unique
  label       String
  description String?
  level       Int
  isSystem    Boolean               @default(false)
  parentId    String?
  path        Unsupported("ltree")?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  parent      Role?                @relation("RoleHierarchy", fields: [parentId], references: [id])
  children    Role[]               @relation("RoleHierarchy")
  permissions RolePermission[]
  userRoles   UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  label       String
  description String?
  module      String
  action      String
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id              String    @id @default(uuid())
  userId          String
  roleId          String
  organizationId  String?
  hospitalGroupId String?
  hospitalId      String?
  departmentId    String?
  unitId          String?
  assignedBy      String?
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)
  hospitalGroup HospitalGroup? @relation(fields: [hospitalGroupId], references: [id])
  hospital      Hospital?      @relation(fields: [hospitalId], references: [id])
  department    Department?    @relation(fields: [departmentId], references: [id])

  @@unique([userId, roleId, organizationId, unitId])
  @@index([userId, isActive])
  @@index([roleId])
  @@index([hospitalGroupId])
  @@index([hospitalId])
  @@index([departmentId])
  @@map("user_role_assignments")
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  password       String
  name           String
  role           UserRole @default(guest)
  organizationId String?
  unitId         String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization           Organization?           @relation(fields: [organizationId], references: [id])
  unit                   Unit?                   @relation(fields: [unitId], references: [id])
  roleAssignments        UserRoleAssignment[]
  auditLogs              AuditLog[]
  schedules              Schedule[]              @relation("ScheduleCreator")
  snapshots              ScheduleSnapshot[]
  recommendations        Recommendation[]
  resolvedConflicts      Conflict[]              @relation("ConflictResolver")
  notificationRecipients NotificationRecipient[]
  sentNotifications      Notification[]          @relation("NotificationSender")
  authSessions           AuthSession[]
  inviteCodes            InviteCode[]
  handoverNotes          HandoverNote[]
  deviceIncidents        DeviceIncident[]
  attendanceRecords      AttendanceRecord[]
  shiftTasks             ShiftTask[]
  deviceStatusLogs       DeviceStatusLog[]
  preShiftChecklists     PreShiftChecklist[]
  pushTokens             PushToken[]
  consentRecords         ConsentRecord[]
  dataSubjectRequests    DataSubjectRequest[]
  emergencyAccessGrants  EmergencyAccessGrant[]  @relation("EmergencyAccessUser")
  emergencyAccessGranted EmergencyAccessGrant[]  @relation("EmergencyAccessGranter")
  webPushSubscriptions    WebPushSubscription[]
  notificationPreferences NotificationPreference?

  @@map("users")
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String   @default("android")
  deviceId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([userId, isActive])
  @@map("push_tokens")
}

model WebPushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  auth      String
  p256dh    String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("web_push_subscriptions")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  units       Unit[]
  devices     Device[]
  shifts      Shifts[]
  inviteCodes InviteCode[]
  dutyRoster  DutyRoster[]
  hospitalId  String?

  hospital         Hospital?         @relation(fields: [hospitalId], references: [id])
  enterpriseAssets EnterpriseAsset[]
  personnelGroups  PersonnelGroup[]
  personShiftTemplates PersonShiftTemplate[]
  schedules            Schedule[]

  @@map("organizations")
}

model HospitalGroup {
  id        String                @id @default(uuid())
  name      String
  code      String                @unique
  path      Unsupported("ltree")?
  isActive  Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  hospitals       Hospital[]
  roleAssignments UserRoleAssignment[]

  @@index([code])
  @@map("hospital_groups")
}

model Hospital {
  id        String                @id @default(uuid())
  groupId   String?
  name      String
  code      String                @unique
  path      Unsupported("ltree")?
  isActive  Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  group            HospitalGroup?       @relation(fields: [groupId], references: [id])
  directorates     Directorate[]
  departments      Department[]
  units            Unit[]
  organizations    Organization[]
  roleAssignments  UserRoleAssignment[]
  enterpriseAssets EnterpriseAsset[]
  warehouses       Warehouse[]

  @@index([code])
  @@map("hospitals")
}

model Directorate {
  id         String                @id @default(uuid())
  hospitalId String
  name       String
  code       String
  path       Unsupported("ltree")?
  isActive   Boolean               @default(true)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  hospital    Hospital     @relation(fields: [hospitalId], references: [id])
  departments Department[]

  @@unique([hospitalId, code])
  @@map("directorates")
}

model Department {
  id            String                @id @default(uuid())
  hospitalId    String?
  directorateId String?
  name          String
  code          String
  path          Unsupported("ltree")?
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  hospital              Hospital?            @relation(fields: [hospitalId], references: [id])
  directorate           Directorate?         @relation(fields: [directorateId], references: [id])
  units                 Unit[]
  roleAssignments       UserRoleAssignment[]
  enterpriseAssets      EnterpriseAsset[]    @relation("AssetDepartment")
  ownedEnterpriseAssets EnterpriseAsset[]    @relation("AssetOwnerDepartment")

  @@unique([hospitalId, code])
  @@map("departments")
}

model Unit {
  id             String                @id @default(uuid())
  name           String
  code           String
  type           UnitType
  organizationId String?
  departmentId   String?
  hospitalId     String?
  path           Unsupported("ltree")?
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization     Organization?     @relation(fields: [organizationId], references: [id])
  department       Department?       @relation(fields: [departmentId], references: [id])
  hospital         Hospital?         @relation(fields: [hospitalId], references: [id])
  users            User[]
  devices          Device[]
  personnel        Personnel[]
  schedules        Schedule[]
  shifts           Shifts[]
  assignments      Assignment[]
  areas            Area[]
  handoverNotes    HandoverNote[]
  deviceIncidents  DeviceIncident[]
  dutyRoster       DutyRoster[]
  enterpriseAssets EnterpriseAsset[]
  personnelGroups  PersonnelGroup[]
  personShiftTemplates PersonShiftTemplate[]

  @@unique([organizationId, code])
  @@map("units")
}

model Area {
  id        String                @id @default(uuid())
  unitId    String
  name      String
  code      String
  type      AreaType              @default(scanning)
  path      Unsupported("ltree")?
  isActive  Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  unit  Unit   @relation(fields: [unitId], references: [id])
  rooms Room[]

  @@unique([unitId, code])
  @@map("areas")
}

model Room {
  id        String                @id @default(uuid())
  areaId    String
  name      String
  code      String
  type      RoomType              @default(patient_exam)
  path      Unsupported("ltree")?
  capacity  Int                   @default(1)
  isActive  Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  area             Area              @relation(fields: [areaId], references: [id])
  devices          Device[]
  assignmentSlots  AssignmentSlot[]
  enterpriseAssets EnterpriseAsset[]

  @@unique([areaId, code])
  @@map("rooms")
}

model AssignmentSlot {
  id         String               @id @default(uuid())
  roomId     String?
  deviceId   String?
  date       String
  startTime  String
  endTime    String
  shiftType  ShiftType
  status     AssignmentSlotStatus @default(available)
  assignedTo String?
  scheduleId String?
  isActive   Boolean              @default(true)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  room   Room?   @relation(fields: [roomId], references: [id])
  device Device? @relation(fields: [deviceId], references: [id])

  @@unique([roomId, deviceId, date, startTime])
  @@index([date])
  @@index([roomId, date])
  @@index([deviceId, date])
  @@index([status])
  @@index([assignedTo])
  @@map("assignment_slots")
}

model DutyRoster {
  id             String         @id @default(uuid())
  organizationId String
  unitId         String?
  deviceId       String?
  personnelId    String
  date           String
  shiftType      ShiftType
  role           DutyRosterRole
  startTime      String
  endTime        String
  notes          String?
  isActive       Boolean        @default(true)
  version        Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  unit         Unit?        @relation(fields: [unitId], references: [id])
  device       Device?      @relation(fields: [deviceId], references: [id])
  personnel    Personnel    @relation(fields: [personnelId], references: [id])

  @@unique([personnelId, date, shiftType])
  @@index([organizationId, date])
  @@index([unitId, date])
  @@index([deviceId, date])
  @@index([date, shiftType])
  @@map("duty_roster")
}

model Personnel {
  id                 String    @id @default(uuid())
  name               String
  role               String    @default("technician")
  employeeNo         String?
  email              String?
  phone              String?
  unitId             String
  groupId            String?
  skills             String[]
  seniority          Int       @default(0)
  specialization     String?
  experienceYears    Int       @default(0)
  certifications     String[]
  deviceSkills       String[]
  nightShiftEligible Boolean   @default(true)
  employmentStatus   String    @default("active")
  startDate          DateTime?
  notes              String?
  offDays            Int[]     @default([])
  maxWeeklyHours     Int       @default(40)
  isActive           Boolean   @default(true)
  version            Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  unit                    Unit                 @relation(fields: [unitId], references: [id])
  group                   PersonnelGroup?      @relation(fields: [groupId], references: [id])
  assignments             Assignment[]
  swapRequestsAsRequester SwapRequest[]        @relation("SwapRequester")
  swapRequestsAsTarget    SwapRequest[]        @relation("SwapTarget")
  personnelSkills         PersonnelSkill[]
  personnelTrainings      PersonnelTraining[]
  dutyRoster              DutyRoster[]
  dosimeters              RadiationDosimeter[]
  calibrationsPerformed   CalibrationRecord[]  @relation("CalibrationPerformer")

  @@unique([email])
  @@unique([employeeNo])
  @@index([unitId])
  @@index([unitId, isActive])
  @@index([groupId])
  @@map("personnel")
}

model Skill {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String   @default("imaging")
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  personnelSkills PersonnelSkill[]

  @@index([category])
  @@map("skills")
}

model PersonnelSkill {
  id                 String    @id @default(uuid())
  personnelId        String
  skillId            String
  certificationLevel String    @default("certified")
  certifiedAt        DateTime?
  expiresAt          DateTime?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  personnel Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  skill     Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([personnelId, skillId])
  @@index([personnelId])
  @@index([skillId])
  @@index([expiresAt])
  @@map("personnel_skills")
}

model Device {
  id             String                @id @default(uuid())
  code           String
  name           String
  unitId         String
  roomId         String?
  organizationId String?
  mode           DeviceMode            @default(vardiya)
  path           Unsupported("ltree")?
  requiredSkills String[]
  workDays       Int[]
  startHour      Int                   @default(8)
  endHour        Int                   @default(20)
  blockCode      String?
  isMaster       Boolean               @default(false)
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  unit             Unit              @relation(fields: [unitId], references: [id])
  room             Room?             @relation(fields: [roomId], references: [id])
  organization     Organization?     @relation(fields: [organizationId], references: [id])
  assignments      Assignment[]
  assignmentSlots  AssignmentSlot[]
  handoverNotes    HandoverNote[]
  deviceIncidents  DeviceIncident[]
  deviceStatusLogs DeviceStatusLog[]
  shiftDefinitions Shifts[]
  dutyRoster       DutyRoster[]
  enterpriseAsset  EnterpriseAsset?

  @@unique([organizationId, code])
  @@index([unitId])
  @@index([roomId])
  @@index([organizationId])
  @@map("devices")
}

model Shifts {
  id                   String    @id @default(uuid())
  name                 String
  type                 ShiftType
  startTime            String?
  endTime              String?
  durationHours        Float?
  organizationId       String
  unitId               String?
  deviceId             String?
  personnelType        String?   @default("technician")
  isMaster             Boolean   @default(false)
  blockId              String?
  optionalOnWeekends   Boolean   @default(false)
  optionalOnHolidays   Boolean   @default(false)
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id])
  unit         Unit?                @relation(fields: [unitId], references: [id])
  device       Device?              @relation(fields: [deviceId], references: [id])
  dateOverrides ShiftDateOverride[]

  @@index([unitId])
  @@index([organizationId])
  @@index([deviceId])
  @@index([blockId])
  @@map("shifts")
}

model ShiftDateOverride {
  id          String   @id @default(uuid())
  shiftId     String
  date        String
  isEnabled   Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shift Shifts @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([shiftId, date])
  @@index([date])
  @@map("shift_date_overrides")
}

model PersonnelGroup {
  id             String    @id @default(uuid())
  organizationId String?
  unitId         String?
  name           String
  code           String
  description    String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization?         @relation(fields: [organizationId], references: [id])
  unit           Unit?                 @relation(fields: [unitId], references: [id])
  personnel      Personnel[]
  shiftTemplates PersonShiftTemplate[]
  assignments    Assignment[]

  @@unique([unitId, code])
  @@index([unitId])
  @@index([isActive])
  @@map("personnel_groups")
}

model PersonShiftTemplate {
  id               String         @id @default(uuid())
  organizationId   String?
  unitId           String
  personnelGroupId String
  name             String
  shiftType        ShiftType
  startTime        String
  endTime          String
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization   Organization?   @relation(fields: [organizationId], references: [id])
  unit           Unit            @relation(fields: [unitId], references: [id])
  personnelGroup PersonnelGroup  @relation(fields: [personnelGroupId], references: [id], onDelete: Cascade)
  assignments    Assignment[]

  @@index([unitId])
  @@index([personnelGroupId])
  @@index([isActive])
  @@map("person_shift_templates")
}

model Schedule {
  id             String         @id @default(uuid())
  unitId         String
  organizationId String?
  month          Int
  year           Int
  version        Int            @default(1)
  status         ScheduleStatus @default(draft)
  publishedAt    DateTime?
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  unit         Unit               @relation(fields: [unitId], references: [id])
  organization Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdBy    User?              @relation("ScheduleCreator", fields: [createdById], references: [id])
  assignments  Assignment[]
  snapshots    ScheduleSnapshot[]
  approval     ScheduleApproval?

  @@unique([unitId, month, year])
  @@index([status])
  @@index([createdById])
  @@index([unitId, createdAt])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("schedules")
}

model ScheduleApproval {
  id               String    @id @default(uuid())
  scheduleId       String    @unique
  submittedBy      String?
  submittedAt      DateTime?
  submittedComment String?
  approvedBy       String?
  approvedAt       DateTime?
  approvalComment  String?
  rejectedBy       String?
  rejectedAt       DateTime?
  rejectionReason  String?
  publishedBy      String?
  publishedAt      DateTime?
  archivedBy       String?
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@map("schedule_approvals")
}

model ScheduleSnapshot {
  id          String   @id @default(uuid())
  scheduleId  String
  version     Int
  data        Json
  createdById String?
  createdAt   DateTime @default(now())

  schedule  Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id])

  @@unique([scheduleId, version])
  @@map("schedule_snapshots")
}

model Assignment {
  id               String         @id @default(uuid())
  scheduleId       String
  personnelId      String
  deviceId         String?
  unitId           String?
  personnelGroupId String?
  shiftTemplateId  String?
  kind             AssignmentKind @default(device)
  source           AssignmentSource @default(manual)
  date             String
  shiftType        ShiftType
  startTime        String
  endTime          String
  personnelType    String         @default("technician")
  isConfirmed      Boolean        @default(false)
  overrideReason   String?
  overriddenBy     String?
  overriddenAt     DateTime?
  version          Int            @default(1)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  schedule        Schedule             @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  personnel       Personnel            @relation(fields: [personnelId], references: [id])
  device          Device?              @relation(fields: [deviceId], references: [id])
  unit            Unit?                @relation(fields: [unitId], references: [id])
  personnelGroup  PersonnelGroup?      @relation(fields: [personnelGroupId], references: [id])
  shiftTemplate   PersonShiftTemplate? @relation(fields: [shiftTemplateId], references: [id])
  swapRequestsFrom   SwapRequest[]     @relation("SwapFromAssignment")
  swapRequestsTo     SwapRequest[]     @relation("SwapToAssignment")
  attendanceRecords  AttendanceRecord[]
  shiftTasks         ShiftTask[]
  preShiftChecklists PreShiftChecklist[]

  @@unique([scheduleId, deviceId, date, shiftType, personnelType])
  @@unique([personnelId, date, shiftType])
  @@index([personnelId, date])
  @@index([deviceId])
  @@index([date])
  @@index([scheduleId])
  @@index([scheduleId, personnelId])
  @@index([scheduleId, date])
  @@index([unitId])
  @@index([personnelGroupId])
  @@index([kind])
  @@map("assignments")
}

model Holiday {
  id        String   @id @default(uuid())
  date      String   @unique
  name      String
  type      String
  year      Int
  createdAt DateTime @default(now())

  @@map("holidays")
}

enum AuditDataClassification {
  UNCLASSIFIED
  PERSONAL
  SENSITIVE_PERSONAL
  HEALTH
  FINANCIAL
  SYSTEM
}

model AuditLog {

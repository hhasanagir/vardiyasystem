  critical_fault
}

enum WasteType {
  expired
  damaged
  recalled
  contaminated
  surplus
  opened_unused
  other
}

// ---- SUPPLIER ----

model Supplier {
  id            String   @id @default(uuid())
  code          String
  name          String
  category      String?
  contactPerson String?
  email         String?
  phone         String?
  mobile        String?
  address       String?
  city          String?
  country       String?
  taxOffice     String?
  taxNumber     String?
  website       String?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contracts          SupplierContract[]
  procurementOrders  ProcurementOrder[]
  consumables        ConsumableCatalog[] @relation("ConsumableSupplier")
  assets             EnterpriseAsset[]   @relation("AssetSupplier")
  serviceContracts   ServiceContract[]
  calibrationVendors CalibrationRecord[] @relation("CalibrationVendor")

  @@unique([code])
  @@index([name])
  @@index([category])
  @@map("suppliers")
}

model EnterpriseAsset {
  id                    String        @id @default(uuid())
  assetNumber           String        @unique
  barcode               String?       @unique
  qrCode                String?
  rfidTag               String?
  name                  String
  category              AssetCategory
  status                AssetStatus   @default(active)
  manufacturer          String?
  model                 String?
  serialNumber          String?
  brand                 String?
  yearOfManufacture     Int?
  installationDate      DateTime?
  acceptanceDate        DateTime?
  commissioningDate     DateTime?
  warrantyStart         DateTime?
  warrantyEnd           DateTime?
  expectedLifetimeYears Int?
  retirementDate        DateTime?
  disposalReason        String?
  purchaseCost          Decimal?      @db.Decimal(12, 2)
  currentValue          Decimal?      @db.Decimal(12, 2)
  supplierId            String?
  contractNumber        String?
  invoiceNumber         String?
  purchaseOrderNumber   String?
  notes                 String?

  // Location
  departmentId String?
  block        String?
  floor        String?
  roomId       String?
  unitId       String?
  hospitalId   String?

  // Ownership
  ownerDepartmentId     String?
  responsibleEngineerId String?
  organizationId        String?

  // Linked Device (backward compatible)
  deviceId String? @unique

  // Metadata
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  supplier        Supplier?     @relation("AssetSupplier", fields: [supplierId], references: [id])
  device          Device?       @relation(fields: [deviceId], references: [id])
  department      Department?   @relation("AssetDepartment", fields: [departmentId], references: [id])
  ownerDepartment Department?   @relation("AssetOwnerDepartment", fields: [ownerDepartmentId], references: [id])
  room            Room?         @relation(fields: [roomId], references: [id])
  unit            Unit?         @relation(fields: [unitId], references: [id])
  hospital        Hospital?     @relation(fields: [hospitalId], references: [id])
  organization    Organization? @relation(fields: [organizationId], references: [id])

  documents             AssetDocument[]
  movements             AssetMovement[]
  maintenanceRecords    MaintenanceRecord[]
  serviceContracts      ServiceContract[]
  consumables           ConsumableCatalog[]    @relation("AssetConsumable")
  qualityRecords        QualityRecord[]
  radiationMeasurements RadiationMeasurement[]
  lifecycleEvents       DeviceLifecycleEvent[]
  consumptionRecords    ConsumptionRecord[]
  calibrationRecords    CalibrationRecord[]

  @@index([assetNumber])
  @@index([barcode])
  @@index([serialNumber])
  @@index([category])
  @@index([status])
  @@index([departmentId])
  @@index([unitId])
  @@index([hospitalId])
  @@index([supplierId])
  @@index([responsibleEngineerId])
  @@map("enterprise_assets")
}

model AssetDocument {
  id           String   @id @default(uuid())
  assetId      String
  type         String // manual, certificate, report, image, contract, other
  title        String
  description  String?
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  uploadedById String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  asset EnterpriseAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([type])
  @@map("asset_documents")
}

model AssetMovement {
  id               String   @id @default(uuid())
  assetId          String
  fromLocation     String?
  toLocation       String
  fromBlock        String?
  toBlock          String?
  fromFloor        String?
  toFloor          String?
  fromRoomId       String?
  toRoomId         String?
  fromDepartmentId String?
  toDepartmentId   String?
  reason           String
  authorizedBy     String?
  performedBy      String?
  notes            String?
  movedAt          DateTime @default(now())
  createdAt        DateTime @default(now())

  asset EnterpriseAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([movedAt])
  @@index([toDepartmentId])
  @@map("asset_movements")
}

// ---- BIOMEDICAL ENGINEERING / MAINTENANCE ----

model MaintenanceRecord {
  id            String              @id @default(uuid())
  assetId       String
  type          MaintenanceType
  priority      MaintenancePriority @default(medium)
  status        MaintenanceStatus   @default(open)
  title         String
  description   String?
  reportedById  String?
  assignedToId  String?
  vendorId      String?
  startDate     DateTime?
  endDate       DateTime?
  downtimeHours Float?
  cost          Decimal?            @db.Decimal(12, 2)
  mtbf          Float? // hours since last failure
  mttr          Float? // hours to repair
  rootCause     String?
  resolution    String?
  closingNotes  String?
  verifiedById  String?
  verifiedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  asset     EnterpriseAsset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  parts     MaintenancePart[]
  documents MaintenanceDocument[]

  @@index([assetId])
  @@index([type])
  @@index([status])
  @@index([priority])
  @@index([startDate])
  @@index([assignedToId])
  @@index([vendorId])
  @@index([assetId, status])
  @@index([assetId, startDate])
  @@map("maintenance_records")
}

model MaintenancePart {
  id            String   @id @default(uuid())
  maintenanceId String
  partName      String
  partNumber    String?
  quantity      Int      @default(1)
  unitCost      Decimal? @db.Decimal(12, 2)
  totalCost     Decimal? @db.Decimal(12, 2)
  supplierId    String?
  stockItemId   String?
  notes         String?
  createdAt     DateTime @default(now())

  maintenance MaintenanceRecord @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)

  @@index([maintenanceId])
  @@map("maintenance_parts")
}

model MaintenanceDocument {
  id            String   @id @default(uuid())
  maintenanceId String
  type          String // report, invoice, photo, approval, certificate
  title         String
  fileUrl       String
  fileSize      Int?
  mimeType      String?
  uploadedById  String?
  createdAt     DateTime @default(now())

  maintenance MaintenanceRecord @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)

  @@index([maintenanceId])
  @@map("maintenance_documents")
}

// ---- SERVICE CONTRACTS ----

model ServiceContract {
  id                String         @id @default(uuid())
  contractNumber    String         @unique
  assetId           String?
  supplierId        String?
  type              ContractType
  status            ContractStatus @default(draft)
  title             String
  description       String?
  startDate         DateTime
  endDate           DateTime
  renewalDate       DateTime?
  value             Decimal?       @db.Decimal(12, 2)
  currency          String         @default("TRY")
  slaResponseTime   String? // e.g. "4 hours"
  slaResolutionTime String? // e.g. "24 hours"
  slaPenalty        String?
  paymentTerms      String?
  scope             String?
  exclusions        String?
  notes             String?
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  asset     EnterpriseAsset?          @relation(fields: [assetId], references: [id])
  supplier  Supplier?                 @relation(fields: [supplierId], references: [id])
  documents ServiceContractDocument[]

  @@index([contractNumber])
  @@index([assetId])
  @@index([supplierId])
  @@index([status])
  @@index([endDate])
  @@index([renewalDate])
  @@map("service_contracts")
}

model ServiceContractDocument {
  id           String   @id @default(uuid())
  contractId   String
  type         String // contract_pdf, amendment, addendum, invoice, other
  title        String
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  uploadedById String?
  createdAt    DateTime @default(now())

  contract ServiceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("service_contract_documents")
}

// ---- CALIBRATION MANAGEMENT ----
// NOTE: calibration is also a MaintenanceType enum value; this model provides detailed tracking

model CalibrationRecord {
  id                  String    @id @default(uuid())
  assetId             String
  calibrationNumber   String    @unique
  type                String // internal, external, factory, vendor
  status              String    @default("scheduled") // scheduled, in_progress, completed, failed, overdue
  scheduledDate       DateTime
  completedDate       DateTime?
  performedById       String?
  vendorId            String?
  standard            String? // ISO 13485, IEC 60601, etc.
  results             String? // pass, conditional_pass, fail
  measurementValues   Json?
  certificateRef      String?
  nextCalibrationDate DateTime?
  intervalDays        Int?
  cost                Decimal?  @db.Decimal(12, 2)
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  asset       EnterpriseAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  performedBy Personnel?      @relation("CalibrationPerformer", fields: [performedById], references: [id])
  vendor      Supplier?       @relation("CalibrationVendor", fields: [vendorId], references: [id])

  @@index([assetId])
  @@index([calibrationNumber])
  @@index([status])
  @@index([scheduledDate])
  @@index([nextCalibrationDate])
  @@map("calibration_records")
}

// ---- CONSUMABLE MANAGEMENT ----

model Warehouse {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  location   String?
  type       String? // main, sub, unit, consumable
  hospitalId String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  hospital        Hospital?               @relation(fields: [hospitalId], references: [id])
  stockItems      ConsumableStock[]
  transactions    ConsumableTransaction[]
  transfersFrom   InventoryTransfer[]     @relation("TransferFromWarehouse")
  transfersTo     InventoryTransfer[]     @relation("TransferToWarehouse")
  inventoryCounts InventoryCount[]

  @@index([code])
  @@index([hospitalId])
  @@map("warehouses")
}

model ConsumableCatalog {
  id            String             @id @default(uuid())
  code          String             @unique
  barcode       String?
  qrCode        String?
  name          String
  category      ConsumableCategory
  manufacturer  String?
  brand         String?
  supplierId    String?
  unitOfMeasure String             @default("piece") // piece, box, liter, ml, set
  packageSize   Int?
  description   String?
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  supplier            Supplier?        @relation("ConsumableSupplier", fields: [supplierId], references: [id])
  asset               EnterpriseAsset? @relation("AssetConsumable", fields: [assetId], references: [id])
  assetId             String?
  compatibleDeviceIds String[]
  compatibleExamTypes String[]

  batches            ConsumableBatch[]
  stockItems         ConsumableStock[]
  transactions       ConsumableTransaction[]
  inventoryTransfers InventoryTransfer[]
  consumptionRecords ConsumptionRecord[]
  inventoryCounts    InventoryCount[]
  wasteRecords       WasteRecord[]
  stockAlerts        StockAlert[]

  @@index([code])
  @@index([barcode])
  @@index([category])
  @@index([supplierId])
  @@index([assetId])
  @@map("consumable_catalog")
}

model ConsumableBatch {
  id               String    @id @default(uuid())
  catalogId        String
  lotNumber        String    @unique
  serialNumber     String?
  manufacturerDate DateTime?
  expirationDate   DateTime?
  quantity         Int       @default(0)
  unitCost         Decimal?  @db.Decimal(12, 2)
  purchaseOrderId  String?
  receivedAt       DateTime  @default(now())
  notes            String?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  catalog      ConsumableCatalog       @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  transactions ConsumableTransaction[]

  @@index([catalogId])
  @@index([lotNumber])
  @@index([expirationDate])
  @@map("consumable_batches")
}

model ConsumableStock {
  id              String   @id @default(uuid())
  catalogId       String
  warehouseId     String
  currentStock    Int      @default(0)
  minimumStock    Int      @default(0)
  maximumStock    Int      @default(100)
  reorderPoint    Int      @default(0)
  reorderQuantity Int?
  shelf           String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  catalog   ConsumableCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  warehouse Warehouse         @relation(fields: [warehouseId], references: [id])

  @@unique([catalogId, warehouseId])
  @@index([warehouseId])
  @@index([catalogId])
  @@index([currentStock])
  @@map("consumable_stock")
}

model ConsumableTransaction {
  id              String                   @id @default(uuid())
  batchId         String?
  catalogId       String
  warehouseId     String?
  type            InventoryTransactionType
  quantity        Int
  unitCost        Decimal?                 @db.Decimal(12, 2)
  totalCost       Decimal?                 @db.Decimal(12, 2)
  referenceType   String? // device, examination, department, procurement
  referenceId     String?
  performedById   String?
  notes           String?
  transactionDate DateTime                 @default(now())
  createdAt       DateTime                 @default(now())

  batch     ConsumableBatch?  @relation(fields: [batchId], references: [id])
  catalog   ConsumableCatalog @relation(fields: [catalogId], references: [id])
  warehouse Warehouse?        @relation(fields: [warehouseId], references: [id])

  @@index([batchId])
  @@index([catalogId])
  @@index([warehouseId])
  @@index([type])
  @@index([transactionDate])
  @@index([referenceType, referenceId])
  @@map("consumable_transactions")
}

// ---- PROCUREMENT ----

model ProcurementRequest {
  id             String            @id @default(uuid())
  requestNumber  String            @unique
  title          String
  description    String?
  requestedById  String?
  departmentId   String?
  priority       String            @default("normal") // low, normal, high, urgent
  status         ProcurementStatus @default(draft)
  estimatedCost  Decimal?          @db.Decimal(12, 2)
  currency       String            @default("TRY")
  justification  String?
  notes          String?
  approvedById   String?
  approvedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  items  ProcurementRequestItem[]
  orders ProcurementOrder[]

  @@index([requestNumber])
  @@index([status])
  @@index([departmentId])
  @@index([requestedById])
  @@map("procurement_requests")
}

model ProcurementRequestItem {
  id                 String    @id @default(uuid())
  requestId          String
  lineNumber         Int
  description        String
  category           String? // asset, consumable, service, spare_part
  catalogId          String?
  quantity           Int       @default(1)
  unitOfMeasure      String    @default("piece")
  estimatedUnitCost  Decimal?  @db.Decimal(12, 2)
  estimatedTotalCost Decimal?  @db.Decimal(12, 2)
  requiredDate       DateTime?
  notes              String?
  createdAt          DateTime  @default(now())

  request ProcurementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("procurement_request_items")
}

model ProcurementOrder {
  id            String            @id @default(uuid())
  orderNumber   String            @unique
  requestId     String?
  supplierId    String?
  title         String
  status        ProcurementStatus @default(draft)
  orderDate     DateTime          @default(now())
  expectedDate  DateTime?
  receivedDate  DateTime?
  totalCost     Decimal?          @db.Decimal(12, 2)
  currency      String            @default("TRY")
  deliveryTerms String?
  paymentTerms  String?
  notes         String?
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  request  ProcurementRequest?    @relation(fields: [requestId], references: [id])
  supplier Supplier?              @relation(fields: [supplierId], references: [id])
  items    ProcurementOrderItem[]
  invoices ProcurementInvoice[]

  @@index([orderNumber])
  @@index([supplierId])
  @@index([status])
  @@index([orderDate])
  @@map("procurement_orders")
}

model ProcurementOrderItem {
  id               String    @id @default(uuid())
  orderId          String
  lineNumber       Int
  description      String
  catalogId        String?
  quantity         Int       @default(1)
  unitOfMeasure    String    @default("piece")
  unitCost         Decimal?  @db.Decimal(12, 2)
  totalCost        Decimal?  @db.Decimal(12, 2)
  receivedQuantity Int       @default(0)
  expectedDate     DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  order ProcurementOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("procurement_order_items")
}

model ProcurementInvoice {
  id            String    @id @default(uuid())
  orderId       String
  invoiceNumber String
  invoiceDate   DateTime  @default(now())
  amount        Decimal   @db.Decimal(12, 2)
  taxAmount     Decimal?  @db.Decimal(12, 2)
  totalAmount   Decimal?  @db.Decimal(12, 2)
  currency      String    @default("TRY")
  fileUrl       String?
  status        String    @default("pending") // pending, paid, overdue, cancelled
  paidAt        DateTime?
  paymentMethod String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  order ProcurementOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([invoiceNumber])
  @@index([status])
  @@map("procurement_invoices")
}

// ---- SUPPLIER CONTRACTS ----

model SupplierContract {
  id             String         @id @default(uuid())
  supplierId     String
  contractNumber String         @unique
  type           ContractType
  status         ContractStatus @default(draft)
  title          String
  description    String?
  startDate      DateTime
  endDate        DateTime
  renewalDate    DateTime?
  value          Decimal?       @db.Decimal(12, 2)
  currency       String         @default("TRY")
  autoRenew      Boolean        @default(false)
  terms          String?
  notes          String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  supplier  Supplier                   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  documents SupplierContractDocument[]

  @@index([supplierId])
  @@index([contractNumber])
  @@index([status])
  @@index([endDate])
  @@index([renewalDate])
  @@map("supplier_contracts")
}

model SupplierContractDocument {
  id           String   @id @default(uuid())
  contractId   String
  type         String // contract, amendment, addendum, invoice, other
  title        String
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  uploadedById String?
  createdAt    DateTime @default(now())

  contract SupplierContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("supplier_contract_documents")
}

// ---- QUALITY MANAGEMENT ----

model QualityRecord {
  id           String              @id @default(uuid())
  recordNumber String              @unique
  type         QualityRecordType
  status       QualityRecordStatus @default(open)
  title        String
  description  String?
  severity     String? // critical, major, minor, observation
  source       String? // audit, inspection, complaint, incident
  departmentId String?
  unitId       String?
  assetId      String?
  reportedById String?
  assignedToId String?
  targetDate   DateTime?
  closedAt     DateTime?
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  asset   EnterpriseAsset? @relation(fields: [assetId], references: [id])
  actions QualityAction[]

  @@index([recordNumber])
  @@index([type])
  @@index([status])
  @@index([severity])
  @@index([departmentId])
  @@index([unitId])
  @@index([assetId])
  @@index([assignedToId])
  @@map("quality_records")
}

model QualityAction {
  id                String    @id @default(uuid())
  recordId          String
  actionNumber      String    @unique
  actionType        String // corrective, preventive
  description       String
  responsibleId     String?
  targetDate        DateTime?
  completedAt       DateTime?
  status            String    @default("open") // open, in_progress, completed, verified, cancelled
  effectiveness     String? // effective, partially_effective, not_effective
  verificationNotes String?
  verifiedById      String?
  verifiedAt        DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  record QualityRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@index([actionNumber])
  @@index([status])
  @@index([responsibleId])
  @@map("quality_actions")
}

// ---- RADIATION SAFETY ----

model RadiationDosimeter {
  id                    String    @id @default(uuid())
  dosimeterNumber       String    @unique
  type                  String // tld, osl, film_badge, electronic
  assignedToId          String?
  issueDate             DateTime  @default(now())
  returnDate            DateTime?
  status                String    @default("active") // active, returned, lost, damaged
  initialReading        Float?
  currentReading        Float?
  annualLimit           Float     @default(20) // mSv
  monthlyAlertThreshold Float     @default(16) // mSv
  notes                 String?
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  measurements RadiationMeasurement[]
  personnel    Personnel?             @relation(fields: [assignedToId], references: [id])

  @@index([dosimeterNumber])
  @@index([assignedToId])
  @@index([status])
  @@map("radiation_dosimeters")
}

model RadiationMeasurement {
  id              String                   @id @default(uuid())
  dosimeterId     String?
  assetId         String?
  type            RadiationMeasurementType
  measurementDate DateTime                 @default(now())
  value           Float
  unit            String                   @default("mSv") // mSv, µSv, mGy, µGy
  location        String?
  performedById   String?
  laboratoryRef   String?
  result          String? // normal, elevated, critical
  notes           String?
  createdAt       DateTime                 @default(now())

  dosimeter RadiationDosimeter? @relation(fields: [dosimeterId], references: [id])
  asset     EnterpriseAsset?    @relation(fields: [assetId], references: [id])

  @@index([dosimeterId])
  @@index([assetId])
  @@index([type])
  @@index([measurementDate])
  @@index([result])
  @@map("radiation_measurements")
}

model RadiationArea {
  id             String    @id @default(uuid())
  code           String    @unique
  name           String
  type           String // controlled, supervised, public
  departmentId   String?
  unitId         String?
  roomId         String?
  classification String? // I, II, III, IV
  doseRateLimit  Float? // µSv/h
  lastSurveyDate DateTime?
  nextSurveyDate DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([code])
  @@index([type])
  @@index([departmentId])
  @@index([unitId])
  @@map("radiation_areas")
}

// === EXTENDED ENTERPRISE MODELS ===

model DeviceLifecycleEvent {
  id              String             @id @default(uuid())
  assetId         String
  eventType       LifecycleEventType
  eventDate       DateTime
  completedDate   DateTime?
  title           String
  description     String?
  performedById   String?
  referenceNumber String?
  referenceType   String?
  locationFrom    String?
  locationTo      String?
  documents       String?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  asset EnterpriseAsset @relation(fields: [assetId], references: [id])

  @@index([assetId])
  @@index([eventType])
  @@index([eventDate])
  @@map("device_lifecycle_events")
}

model InventoryTransfer {
  id              String         @id @default(uuid())
  transferNumber  String         @unique
  fromWarehouseId String?
  toWarehouseId   String?
  fromUnitId      String?
  toUnitId        String?
  catalogId       String
  quantity        Int
  batchNumber     String?
  status          TransferStatus @default(draft)
  requestedById   String?
  approvedById    String?
  approvedAt      DateTime?
  completedById   String?
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  fromWarehouse Warehouse?        @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse?        @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id])
  catalog       ConsumableCatalog @relation(fields: [catalogId], references: [id])

  @@index([transferNumber])
  @@index([status])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([catalogId])
  @@map("inventory_transfers")
}

model ConsumptionRecord {
  id              String          @id @default(uuid())
  catalogId       String
  quantity        Int
  consumptionType ConsumptionType
  assetId         String?
  examinationType String?
  departmentId    String?
  unitId          String?
  batchNumber     String?
  recordedById    String?
  recordedAt      DateTime        @default(now())
  cost            Decimal?        @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime        @default(now())

  catalog ConsumableCatalog @relation(fields: [catalogId], references: [id])
  asset   EnterpriseAsset?  @relation(fields: [assetId], references: [id])

  @@index([catalogId])
  @@index([assetId])
  @@index([consumptionType])
  @@index([recordedAt])
  @@map("consumption_records")
}

model InventoryCount {
  id              String    @id @default(uuid())
  countNumber     String    @unique
  warehouseId     String?
  catalogId       String
  expectedQty     Int
  actualQty       Int
  difference      Int
  unitCost        Decimal?  @db.Decimal(12, 2)
  totalDifference Decimal?  @db.Decimal(12, 2)
  countedById     String?
  countedAt       DateTime  @default(now())
  approvedById    String?
  approvedAt      DateTime?
  status          String    @default("pending")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  warehouse Warehouse?        @relation(fields: [warehouseId], references: [id])
  catalog   ConsumableCatalog @relation(fields: [catalogId], references: [id])

  @@index([countNumber])
  @@index([warehouseId])
  @@index([catalogId])
  @@index([status])
  @@map("inventory_counts")
}

model WasteRecord {
  id             String    @id @default(uuid())
  wasteNumber    String    @unique
  catalogId      String
  quantity       Int
  wasteType      WasteType
  batchNumber    String?
  reason         String
  disposalMethod String?
  disposedById   String?
  disposedAt     DateTime  @default(now())
  cost           Decimal?  @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime  @default(now())

  catalog ConsumableCatalog @relation(fields: [catalogId], references: [id])

  @@index([wasteNumber])
  @@index([catalogId])
  @@index([wasteType])
  @@index([disposedAt])
  @@map("waste_records")
}

model StockAlert {
  id           String    @id @default(uuid())
  catalogId    String
  alertType    AlertType
  threshold    Int?
  currentValue Int
  message      String
  severity     String    @default("warning")
  isResolved   Boolean   @default(false)
  resolvedAt   DateTime?
  resolvedById String?
  notifiedAt   DateTime?
  createdAt    DateTime  @default(now())

  catalog ConsumableCatalog @relation(fields: [catalogId], references: [id])

  @@index([catalogId])
  @@index([alertType])
  @@index([isResolved])
  @@index([severity])
  @@map("stock_alerts")
}

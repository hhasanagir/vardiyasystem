    "@nestjs/core": "^12.6.3",
    "@nestjs/cqrs": "^12.1.3",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/passport": "^12.0.2",
    "@nestjs/platform-express": "^12.6.3",
    "@nestjs/platform-socket.io": "^12.6.3",
    "@nestjs/schedule": "^12.0.4",
    "@nestjs/swagger": "^12.1.3",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/websockets": "^12.6.3",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/instrumentation-nestjs-core": "^0.72.1",
    "@opentelemetry/instrumentation-socket.io": "^0.72.0",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@prisma/client": "^5.8.0",
    "@prisma/instrumentation": "^7.10.1",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.78.0",
    "cache-manager": "^6.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.0",
    "joi": "^18.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.18.0",
    "prom-client": "^15.1.3",
    "prisma": "^5.8.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "uuid": "^11.1.1",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "overrides": {
    "tar": "7.5.22",
    "@angular-devkit/core": {
      "ajv": "8.20.0"
    },
    "body-parser": "1.20.9",
    "fast-uri": "3.1.9",
    "fast-xml-parser": "5.12.1",
    "gcp-metadata": "9.2.3",
    "glob@10.4.5": "10.5.0",
    "js-yaml": "4.3.2",

# ─────────────────────────────────────────────────
# VardiyaOS Backend — Environment Configuration
# ─────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────

# ── Database ──────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vardiyasystem?schema=public"
# Direct connection (for Prisma migrations, bypasses PgBouncer if configured)
DATABASE_DIRECT_URL="postgresql://postgres:postgres@localhost:5432/vardiyasystem?schema=public"

# ── JWT Authentication ────────────────────────────
# Generate strong secrets: openssl rand -base64 32
JWT_ACCESS_TOKEN_SECRET="change-me-to-a-random-64-char-string"
JWT_REFRESH_TOKEN_SECRET="change-me-to-another-random-64-char-string"
JWT_ACCESS_TOKEN_EXPIRES_IN="15m"
JWT_REFRESH_TOKEN_EXPIRES_IN="7d"

# ── Server ────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────
FRONTEND_URL="http://localhost:4200"

# ── WebSocket ─────────────────────────────────────
WS_CORS_ORIGIN="http://localhost:4200"

# ── Seed (development only) ───────────────────────
SEED_ADMIN_PASSWORD="admin123"
SEED_TECHNICIAN_PASSWORD="technician123"

# ── Rate Limiting ──────────────────────────────────
GLOBAL_THROTTLE_TTL=60000
GLOBAL_THROTTLE_LIMIT=200
AUTH_LOGIN_LIMIT=10
AUTH_LOGIN_WINDOW_MS=60000
AUTH_REGISTER_LIMIT=3
AUTH_REGISTER_WINDOW_MS=60000
AUTH_REFRESH_LIMIT=10
AUTH_REFRESH_WINDOW_MS=60000

# ── Brute Force Lockout ────────────────────────────
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_DURATION_MS=900000
AUTH_LOCKOUT_PROGRESSIVE_FACTOR=1.5
AUTH_LOCKOUT_MAX_DURATION_MS=86400000

# ── WebSocket Rate Limiting ────────────────────────
WS_CONNECTION_LIMIT=10
WS_CONNECTION_WINDOW_MS=60000
WS_RECONNECT_COOLDOWN_MS=2000

# ── Push Notifications (VAPID) ─────────────────────
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="BJmBEUlEpzbxsHEWjAAFuI-iKEJ171-JUZYmtVYBc-V84pBMyvqLDGtCeW__3I3OjaKYQ7TLpqOTQKuzCHLKNOc"
VAPID_PRIVATE_KEY="LCOGiaom9OORU7nWAZoBeNgtFVGdf-bCjRuKBkUE-Iw"
VAPID_SUBJECT="mailto:vardiyaos@hospital.com"

# ── Proxy ──────────────────────────────────────────
TRUST_PROXY_LEVEL=1

# ── Cookie Signing (protects CSRF and session cookies from tampering) ─
# Generate: openssl rand -base64 32
COOKIE_SECRET="change-me-to-a-random-64-char-string"

# ── Alerting ──────────────────────────────────────
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."

# ── (Optional) Redis / SMTP ───────────────────────
# REDIS_URL="redis://localhost:6379"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="user@example.com"
# SMTP_PASS=""
